FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci

FROM dependencies AS build
COPY prisma ./prisma
RUN npx prisma generate
COPY tsconfig*.json nest-cli.json ./
COPY src ./src
RUN npm run build

FROM node:22-bookworm-slim AS production-dependencies
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates dumb-init && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/node_modules/@prisma/client ./node_modules/@prisma/client

FROM dependencies AS migrate
ENV NODE_ENV=production
COPY prisma ./prisma
COPY src ./src
COPY tsconfig*.json ./
ENTRYPOINT ["npx", "prisma", "migrate", "deploy"]

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000 STORAGE_ROOT=/app/storage
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates dumb-init && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 precheck \
  && useradd --system --uid 1001 --gid precheck --home-dir /app precheck \
  && mkdir -p /app/storage /app/fonts \
  && chown -R precheck:precheck /app
COPY --from=production-dependencies --chown=precheck:precheck /app/node_modules ./node_modules
COPY --from=build --chown=precheck:precheck /app/dist ./dist
COPY --from=build --chown=precheck:precheck /app/prisma ./prisma
COPY --chown=precheck:precheck package.json ./package.json
USER precheck
EXPOSE 3000
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main.js"]
