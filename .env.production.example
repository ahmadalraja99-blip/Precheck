# Copy to .env.production, replace every required placeholder, and never commit that file.
NODE_ENV=production
POSTGRES_DB=precheck_outcheck
POSTGRES_USER=precheck_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql://precheck_app:URL_ENCODED_PASSWORD@postgres:5432/precheck_outcheck?schema=public

JWT_ACCESS_SECRET=REPLACE_WITH_INDEPENDENT_HIGH_ENTROPY_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_HIGH_ENTROPY_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
API_PREFIX=api/v1
FRONTEND_ORIGIN=https://example.com

STORAGE_ROOT=/app/storage
REPORT_FONT_REGULAR_PATH=/app/fonts/regular.ttf
REPORT_FONT_BOLD_PATH=/app/fonts/bold.ttf

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PreCheck System <no-reply@example.com>

OPERATIONAL_REPORT_JOB_ENABLED=true
OPERATIONAL_REPORT_JOB_INTERVAL_MS=30000
OPERATIONAL_REPORT_JOB_MAX_ATTEMPTS=5
OPERATIONAL_REPORT_JOB_RETRY_BASE_MS=60000
OPERATIONAL_REPORT_JOB_STALE_LOCK_MS=600000
OPERATIONAL_REPORT_JOB_BATCH_SIZE=10

OPERATIONAL_REPORT_EMAIL_ENABLED=false
OPERATIONAL_REPORT_EMAIL_AUTO_SEND=false
OPERATIONAL_REPORT_EMAIL_INCLUDE_PDF=true
OPERATIONAL_REPORT_EMAIL_INCLUDE_EXCEL=true
OPERATIONAL_REPORT_EMAIL_TO_ADMINS=true
OPERATIONAL_REPORT_EMAIL_TO_COMPANY=false
OPERATIONAL_REPORT_EMAIL_CC=
OPERATIONAL_REPORT_EMAIL_BCC=
OPERATIONAL_REPORT_EMAIL_MAX_ATTEMPTS=5
OPERATIONAL_REPORT_EMAIL_RETRY_BASE_MS=60000
OPERATIONAL_REPORT_EMAIL_INTERVAL_MS=30000
OPERATIONAL_REPORT_EMAIL_BATCH_SIZE=10
OPERATIONAL_REPORT_EMAIL_STALE_LOCK_MS=600000
OPERATIONAL_REPORT_EMAIL_LOCALE=en

DUTY_EXPIRATION_CRON=*/1 * * * *
DAILY_BACKUP_CRON=0 1 * * *
WEEKLY_BACKUP_CRON=0 2 * * 1

# Used only for the explicit one-time production bootstrap command.
SEED_SUPER_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
SEED_SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
SEED_SUPER_ADMIN_FULL_NAME=REPLACE_WITH_ADMIN_NAME

# Frontend build-time public URL. It must include the API prefix.
NEXT_PUBLIC_API_BASE_URL=https://example.com/api/v1
