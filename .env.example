# docker-compose maps PostgreSQL to host port 5433.
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/precheck_outcheck?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001
API_PREFIX="api/v1"
STORAGE_ROOT="storage"
REPORT_FONT_REGULAR_PATH=""
REPORT_FONT_BOLD_PATH=""
OPERATIONAL_REPORT_JOB_INTERVAL_MS=30000
OPERATIONAL_REPORT_JOB_MAX_ATTEMPTS=5
OPERATIONAL_REPORT_JOB_RETRY_BASE_MS=60000
OPERATIONAL_REPORT_JOB_STALE_LOCK_MS=600000
OPERATIONAL_REPORT_JOB_BATCH_SIZE=10
OPERATIONAL_REPORT_JOB_ENABLED=true
OPERATIONAL_REPORT_EMAIL_ENABLED=true
OPERATIONAL_REPORT_EMAIL_AUTO_SEND=true
OPERATIONAL_REPORT_EMAIL_INCLUDE_PDF=true
OPERATIONAL_REPORT_EMAIL_INCLUDE_EXCEL=true
OPERATIONAL_REPORT_EMAIL_TO_ADMINS=true
OPERATIONAL_REPORT_EMAIL_TO_COMPANY=false
OPERATIONAL_REPORT_EMAIL_CC=""
OPERATIONAL_REPORT_EMAIL_BCC=""
OPERATIONAL_REPORT_EMAIL_LOCALE=en
OPERATIONAL_REPORT_EMAIL_MAX_ATTEMPTS=5
OPERATIONAL_REPORT_EMAIL_RETRY_BASE_MS=60000
OPERATIONAL_REPORT_EMAIL_INTERVAL_MS=30000
OPERATIONAL_REPORT_EMAIL_BATCH_SIZE=10
OPERATIONAL_REPORT_EMAIL_STALE_LOCK_MS=600000

# SMTP is optional in local development. Leave SMTP_HOST empty to log EMAIL_FAILED without blocking the workflow.
SMTP_HOST=""
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PreCheck System <no-reply@example.com>"

SEED_SUPER_ADMIN_EMAIL="super.admin@example.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"
SEED_SUPER_ADMIN_FULL_NAME="System Super Admin"

DAILY_BACKUP_CRON="0 1 * * *"
WEEKLY_BACKUP_CRON="0 2 * * 1"
DUTY_EXPIRATION_CRON="*/1 * * * *"
