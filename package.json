{
  "name": "online-precheck-outcheck-backend",
  "version": "1.0.0",
  "description": "Backend-only NestJS system for Damascus International Airport Online PreCheck / OutCheck operations.",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,prisma}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"docs/**/*.md\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed-company-user-rbac": "ts-node prisma/seed-company-user-rbac.ts",
    "test:company-user-rbac": "ts-node prisma/verify-company-user-rbac.ts",
    "prisma:update-airlines": "ts-node prisma/update-airlines.ts",
    "verify": "npm run prisma:generate && npm run build",
    "test:operational-reports": "node -r ts-node/register/transpile-only test/operational-flight-reports.test.ts",
    "test:operational-report-jobs": "node -r ts-node/register/transpile-only test/operational-report-jobs.test.ts",
    "test:operational-report-email-jobs": "node -r ts-node/register/transpile-only test/operational-report-email-jobs.test.ts",
    "test:outcheck-failure-workflow": "node -r ts-node/register/transpile-only test/outcheck-failure-workflow.test.ts",
    "test:daily-duty-lifecycle": "node -r ts-node/register/transpile-only test/daily-duty-lifecycle.test.ts",
    "test:rbac": "node -r ts-node/register/transpile-only test/rbac.test.ts",
    "test:configuration-management": "node -r ts-node/register/transpile-only test/configuration-management.test.ts",
    "test:realtime": "node -r ts-node/register/transpile-only test/realtime.test.ts",
    "test:e2e-final": "node -r ts-node/register/transpile-only test/e2e-final.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/websockets": "11.1.28",
    "@prisma/client": "^5.22.0",
    "bcrypt": "6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "helmet": "^7.2.0",
    "nodemailer": "9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/bcrypt": "6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
